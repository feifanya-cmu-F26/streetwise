# No secrets are needed for the local demo. Live services are not implemented yet.
STREETWISE_MODE=demo

# Optional: enables a real Mapbox basemap with demo issue markers (public token).
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Future server-only integrations. Adding keys alone does not enable them.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=issue-evidence
MAPBOX_ACCESS_TOKEN=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4-mini
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
